node('workernode1') {
  
    def mvnHome = tool 'maven3'
    def dockerRepoUrl = "localhost:8083"
    def dockerImageName = "hello-world-java"
    def dockerImageTag = "${dockerRepoUrl}/${dockerImageName}:${env.BUILD_NUMBER}"
    
    stage('Clone Repo') { 
      git 'https://github.com/arungane944/docker-hello-world-spring-boot.git'         
      mvnHome = tool 'maven3'
    }    
  
    stage('Build Project') {
      sh "'${mvnHome}/bin/mvn' -Dmaven.test.failure.ignore clean package"
    }
	
	stage('Publish Tests Results'){
      parallel(
        publishJunitTestsResultsToJenkins: {
          echo "Publish junit Tests Results"
		  junit '**/target/surefire-reports/TEST-*.xml'
		  archive 'target/*.jar'
        },
        publishJunitTestsResultsToSonar: {
          echo "This is branch b"
      })
    }
		
    stage('Build Docker Image') {
      sh "whoami"
      sh "mv ./target/hello*.jar ./data" 
      dockerImage = docker.build("hello-world-java") // passing custom image name
      // load build definition from Dockerfile, Here it build the docker image based on 
      // the Dockerfile configured in above git repo
    }
   
    stage('Deploy Docker Image'){
      
      echo "Docker Image Tag Name: ${dockerImageTag}"
      

      //sh "docker login -u admin -p admin123 ${dockerRepoUrl}"
      sh "docker tag ${dockerImageName} ${dockerImageTag}"
      //sh "docker push ${dockerImageTag}"
    }
}