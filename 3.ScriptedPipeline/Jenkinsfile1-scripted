// This is scripted pipeline example

// In node block, we can define the node/agent where the pipeline will run

// In this case, we are using a node named 'workernode1' and 'workernode2'

node('workernode1') { 
    def mvnHome
    stage('Preparation') { 
        git 'https://github.com/jglick/simple-maven-project-with-tests.git'
        mvnHome = tool 'maven3'
    }
    stage('Build') {
        withEnv(["MVN_HOME=$mvnHome"]) {
            if (isUnix()) {
                sh '"$MVN_HOME/bin/mvn" -Dmaven.test.failure.ignore clean package'
            } else {
                bat(/"%MVN_HOME%\bin\mvn" -Dmaven.test.failure.ignore clean package/)
            }
        }
    }
    stage('Results') {
        junit '**/target/surefire-reports/TEST-*.xml'
        archiveArtifacts 'target/*.jar'
    }
    node('workernode2') {
        stage('pipeline-succed') {
            echo "Pipeline succeded"
        }
    }
}
