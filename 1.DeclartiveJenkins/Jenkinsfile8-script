pipeline {
    agent any
    stages {
        stage('checkout') {
            steps {
                script {
                    checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/arungane944/docker-hello-world-spring-boot.git']])
                }
            }
        }
        stage('script-pipeline') {
            steps {
                script {
                    echo 'This is a script pipeline'
                    sh 'cd scripts && chmod +x helloworld.sh && ./helloworld.sh'
                }
            }
        }
    }
}