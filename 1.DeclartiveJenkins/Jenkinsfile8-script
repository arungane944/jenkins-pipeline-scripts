pipeline {
    agent any
    stages {
        stage('checkout') {
            steps {
                script {
                    checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/arungane944/jenkins-pipeline-scripts.git']])
                }
            }
        }
        stage('script-pipeline') {
            steps {
                script {
                    echo 'This is a script pipeline'
                    sh 'cd 1.DeclartiveJenkins/scripts && chmod +x helloworld.sh && ./helloworld.sh'
                }
            }
        }
    }
}