pipeline {
    agent any
    parameters {
        string defaultValue: 'Arun', description: 'This is a parameter', name: 'MY_PARAM', trim: true
        choice choices: ['option1 option2 option3'], description: 'This is a choice parameter', name: 'MY_CHOICE_PARAM'
}

    stages {
        stage('Build') {
            steps {
                script {
                    echo "Building with parameter: ${params.MY_PARAM}"
                    echo "Choice parameter: ${params.MY_CHOICE_PARAM}"
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    echo "Testing with parameter: ${params.MY_PARAM}"
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying with parameter: ${params.MY_PARAM}"
                }
            }
        }
    }
    

}