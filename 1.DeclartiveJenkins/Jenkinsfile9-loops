// Loops - for, while, do-while

pipeline {
    agent any
    stages {
        stage('loops') {
            steps {
                script {
                    // For loop
                    for (int i = 0; i < 5; i++) {
                        echo "For loop iteration: ${i}"
                    }

                    // While loop
                    int j = 0
                    while (j < 5) {
                        echo "While loop iteration: ${j}"
                        j++
                    }

                    // Do-while loop
                    int k = 0
                    do {
                        echo "Do-while loop iteration: ${k}"
                        k++
                    } while (k < 5)
                }
            }
        }
    }
}