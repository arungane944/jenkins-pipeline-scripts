// Docker plugins:
// 1. Docker plugin: Agent based purposes
// 2. Docker pipeline plugin: Pipeline based purposes

pipeline {
    agent {
        label 'workernode1'
    }
    tools {
        maven 'maven-3'
        docker 'docker'
    }
    stages {
        stage('checkout') {
            steps {
                script {
                    checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/arungane944/docker-hello-world-spring-boot.git']])
                }
            }
        }
        stage('Maven Build') {
            steps {
                script {
                    sh "mvn clean package" 
                }
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    sh "docker build -t hello-world-spring-boot:latest ." 
                }
            }
        }
    }
}