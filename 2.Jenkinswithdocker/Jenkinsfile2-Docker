// Docker plugins:
// 1. Docker plugin: Agent based purposes
// 2. Docker pipeline plugin: Pipeline based purposes

pipeline {
    agent {
        label 'workernode1'
    }
    tools {
        maven 'maven3'
    }
    stages {
        stage('checkout') {
            steps {
                script {
                    checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/arungane944/docker-hello-world-spring-boot.git']])
                }
            }
        }
        stage('Mvn Build') {
            steps {
                script {
                    sh 'mvn -Dmaven.test.failure.ignore clean package'
                    echo 'mvn build successfully'
                }
            }
        }
        stage('docker Build') {
            steps {
                script {
                    //build docker image
                    sh "whoami"
                    sh "docker build -t hello-world-spring-boot:latest ."
                    sh "ls -all /var/run/docker.sock"
                    sh "mv ./target/hello*.jar ./data" 
                }
            }
        }
    }
}