// Docker plugins:
// 1. Docker plugin: Agent based purposes
// 2. Docker pipeline plugin: Pipeline based purposes

pipeline {
    agent {
        label 'workernode1'
    }
    stages {
        stage('checkout') {
            steps {
                script {
                    checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/arungane944/docker-hello-world-spring-boot.git']])
                }
            }
        }
        stage('Build') {
            steps {
                script {
                    sh "build successfully" 
                }
            }
        }
    }
}